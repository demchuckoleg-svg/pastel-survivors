{
  "name": "pastel-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.shared.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:shared": "tsc -p tsconfig.shared.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:server": "esbuild src/server/test-coop.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test": "npm run test:server",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
